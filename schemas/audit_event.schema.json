{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpmodel.local/schemas/audit_event.schema.json",
  "title": "MCPModel decision audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "case_id", "inherent_risk", "risk_probability", "risk_set", "decision", "matched_rules", "authorization_gaps", "reason_codes", "model_version", "policy_version"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "inherent_risk": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "risk_probability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2", "L3", "L4"],
      "properties": {
        "L0": {"type": "number", "minimum": 0, "maximum": 1},
        "L1": {"type": "number", "minimum": 0, "maximum": 1},
        "L2": {"type": "number", "minimum": 0, "maximum": 1},
        "L3": {"type": "number", "minimum": 0, "maximum": 1},
        "L4": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "risk_set": {"type": "array", "items": {"enum": ["L0", "L1", "L2", "L3", "L4"]}, "minItems": 1, "uniqueItems": true},
    "decision": {"enum": ["allow", "isolate", "rewrite", "approve", "deny"]},
    "residual_risk_set": {"type": "array", "items": {"enum": ["L0", "L1", "L2", "L3", "L4"]}, "uniqueItems": true},
    "matched_rules": {"type": "array", "items": {"type": "string"}},
    "authorization_gaps": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "model_version": {"type": "string"},
    "policy_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
